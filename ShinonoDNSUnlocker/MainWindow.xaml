<Window x:Class="ShinonoDNSUnlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ShinonoDNSUnlocker (SDU) - Steam Unlocker" Height="700" Width="900"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}" Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SHINONO DNS UNLOCKER" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueLightBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="txtLanguage" Text="Language:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="VN" x:Name="btnLangVN" Click="BtnLangVN_Click" Margin="0,0,5,0" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                <Button Content="EN" x:Name="btnLangEN" Click="BtnLangEN_Click" Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>
        </Grid>

        <!-- Network Selector -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblAdapter" Text="Chọn Card Mạng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0" Grid.Column="0"/>
            <ComboBox x:Name="cmbAdapters" Grid.Column="1" materialDesign:HintAssist.Hint="Đang tìm các kết nối mạng..." Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,15,0"/>
            <Button x:Name="btnRefreshAdapters" Content="Refresh" Grid.Column="2" Click="BtnRefreshAdapters_Click"/>
        </Grid>

        <!-- Cards Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Card Cloudflare -->
            <materialDesign:Card Grid.Row="0" Grid.Column="0" Margin="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="CLOUDFLARE DNS" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="lblPingCF" Text="Ping: Đang đo..." Foreground="Gray" Margin="0,5,0,15"/>
                    <Button x:Name="btnSetCF" Content="1. Set DNS (Khuyên dùng)" Click="BtnSetCF_Click" Margin="0,0,0,10"/>
                    <Button x:Name="btnSetCFDoH" Content="2. Set DNS + DoH (Mạnh hơn)" Click="BtnSetCFDoH_Click" Style="{StaticResource MaterialDesignFlatSecondaryDarkBgButton}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Card Google -->
            <materialDesign:Card Grid.Row="0" Grid.Column="1" Margin="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="GOOGLE DNS" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="lblPingGG" Text="Ping: Đang đo..." Foreground="Gray" Margin="0,5,0,15"/>
                    <Button x:Name="btnSetGG" Content="1. Set DNS (Khuyên dùng)" Click="BtnSetGG_Click" Margin="0,0,0,10"/>
                    <Button x:Name="btnSetGGDoH" Content="2. Set DNS + DoH (Mạnh hơn)" Click="BtnSetGGDoH_Click" Style="{StaticResource MaterialDesignFlatSecondaryDarkBgButton}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Card Custom DNS -->
            <materialDesign:Card Grid.Row="1" Grid.Column="0" Margin="5" Padding="15">
                <StackPanel>
                    <TextBlock x:Name="lblCustomTitle" Text="CUSTOM DNS" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox x:Name="txtCustomDNS1" materialDesign:HintAssist.Hint="IPv4 Primary (VD: 9.9.9.9)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                    <TextBox x:Name="txtCustomDNS2" materialDesign:HintAssist.Hint="IPv4 Secondary (VD: 149.112.112.112)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                    <Button x:Name="btnSetCustom" Content="Áp dụng Custom DNS" Click="BtnSetCustom_Click"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Card Hosts Bypass -->
            <materialDesign:Card Grid.Row="1" Grid.Column="1" Margin="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="STEAM HOSTS BYPASS" FontSize="18" FontWeight="Bold" Foreground="OrangeRed"/>
                    <TextBlock x:Name="lblHostsDesc" Text="Dùng khi đổi DNS không hiệu quả. Sửa trực tiếp file hệ thống." TextWrapping="Wrap" Margin="0,5,0,15"/>
                    <Button x:Name="btnApplyHosts" Content="Áp dụng Hosts Bypass" Background="OrangeRed" BorderBrush="OrangeRed" Click="BtnApplyHosts_Click" Margin="0,0,0,10"/>
                    <Button x:Name="btnRemoveHosts" Content="Xóa Hosts Bypass" Click="BtnRemoveHosts_Click" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Controls -->
        <Grid Grid.Row="3" Margin="0,15,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnRestore" Content="Khôi phục Mặc định (DHCP)" Width="250" Click="BtnRestore_Click" Margin="0,0,20,0" Style="{StaticResource MaterialDesignPaperSecondaryButton}"/>
                <Button x:Name="btnTestSteam" Content="Kiểm tra Kết nối Steam" Width="250" Click="BtnTestSteam_Click"/>
            </StackPanel>
        </Grid>

        <!-- Log Terminal -->
        <GroupBox Grid.Row="4" Header="System Logs (Trạng thái)">
            <ScrollViewer x:Name="LogScroll">
                <TextBlock x:Name="txtLog" FontFamily="Consolas" Foreground="LightGreen" TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
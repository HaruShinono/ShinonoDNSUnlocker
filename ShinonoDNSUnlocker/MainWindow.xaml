<Window x:Class="ShinonoDNSUnlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ShinonoDNSUnlocker (SDU) - Steam Unlocker" 
        Height="730" Width="820" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}" Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Network -->
            <RowDefinition Height="Auto"/>
            <!-- Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Utilities -->
            <RowDefinition Height="*"/>
            <!-- Log Box -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon x:Name="HeaderIcon" Kind="ShieldCheckOutline" Width="36" Height="36" Margin="0,0,10,0"/>
                <TextBlock x:Name="HeaderText" Text="SHINONO DNS UNLOCKER" FontSize="26" FontWeight="ExtraBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnThemeToggle" Click="BtnThemeToggle_Click" Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="Đổi Giao diện Sáng/Tối" Margin="0,0,15,0">
                    <materialDesign:PackIcon Kind="ThemeLightDark" Width="24" Height="24"/>
                </Button>
                <TextBlock x:Name="txtLanguage" Text="Language:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="VN" x:Name="btnLangVN" Click="BtnLangVN_Click" Margin="0,0,5,0" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="10,0"/>
                <Button Content="EN" x:Name="btnLangEN" Click="BtnLangEN_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="10,0"/>
            </StackPanel>
        </Grid>

        <!-- Network Selector -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblAdapter" Text="Chọn Card Mạng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0"/>
            <ComboBox x:Name="cmbAdapters" Grid.Column="1" materialDesign:HintAssist.Hint="Đang tìm các kết nối mạng..." Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,15,0" SelectionChanged="CmbAdapters_SelectionChanged"/>
            <Button x:Name="btnRefreshAdapters" Content="Refresh" Grid.Column="2" Click="BtnRefreshAdapters_Click" Style="{StaticResource MaterialDesignFlatButton}"/>
        </Grid>

        <!-- Main Feature Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card Cloudflare -->
            <materialDesign:Card Grid.Row="0" Grid.Column="0" Margin="5" Padding="15" Background="{DynamicResource MaterialDesignCardBackground}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <materialDesign:PackIcon Kind="CloudOutline" Width="24" Height="24" Foreground="#FF9900" Margin="0,0,8,0"/>
                        <TextBlock Text="CLOUDFLARE" FontSize="18" FontWeight="Bold" Foreground="#FF9900" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="lblPingCF" Text="Ping: Đang đo..." Margin="0,0,0,15" FontWeight="SemiBold"/>
                    <Button x:Name="btnSetCF" Content="1. Set DNS" Click="BtnSetCF_Click" Margin="0,0,0,10" Background="#FF9900" BorderBrush="#FF9900" Foreground="White" FontWeight="Bold"/>
                    <Button x:Name="btnSetCFDoH" Content="2. Set DNS + DoH (Mạnh)" Click="BtnSetCFDoH_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#FF9900" Foreground="#FF9900"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Card Google -->
            <materialDesign:Card Grid.Row="0" Grid.Column="1" Margin="5" Padding="15" Background="{DynamicResource MaterialDesignCardBackground}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <materialDesign:PackIcon Kind="Google" Width="24" Height="24" Foreground="#4285F4" Margin="0,0,8,0"/>
                        <TextBlock Text="GOOGLE DNS" FontSize="18" FontWeight="Bold" Foreground="#4285F4" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="lblPingGG" Text="Ping: Đang đo..." Margin="0,0,0,15" FontWeight="SemiBold"/>
                    <Button x:Name="btnSetGG" Content="1. Set DNS" Click="BtnSetGG_Click" Margin="0,0,0,10" Background="#4285F4" BorderBrush="#4285F4" Foreground="White" FontWeight="Bold"/>
                    <Button x:Name="btnSetGGDoH" Content="2. Set DNS + DoH (Mạnh)" Click="BtnSetGGDoH_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#4285F4" Foreground="#4285F4"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Card Steam Hosts Bypass -->
            <materialDesign:Card Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,10,5,5" Padding="15" BorderBrush="#FF3B30" BorderThickness="1.5" Background="{DynamicResource MaterialDesignCardBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <materialDesign:PackIcon Kind="Steam" Width="28" Height="28" Foreground="#FF3B30" Margin="0,0,8,0"/>
                            <TextBlock Text="STEAM HOSTS BYPASS" FontSize="20" FontWeight="Black" Foreground="#FF3B30" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="lblHostsDesc" Text="Dùng khi DNS/DoH không hoạt động. Ghi IP trực tiếp vào hệ thống." TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnApplyHosts" Content="ÁP DỤNG BYPASS" Background="#FF3B30" BorderBrush="#FF3B30" Foreground="White" FontWeight="Bold" Click="BtnApplyHosts_Click" Margin="0,0,10,0"/>
                        <Button x:Name="btnRemoveHosts" Content="XÓA BYPASS" Click="BtnRemoveHosts_Click" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#FF3B30" Foreground="#FF3B30"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Utility Controls (Căn đều và làm nổi bật nút Gỡ) -->
        <Grid Grid.Row="3" Margin="5,0,5,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnRestore" Content="XÓA CÀI ĐẶT: Trả về Tự Động (Auto)" Click="BtnRestore_Click" Background="#424242" BorderBrush="#424242" Foreground="White" Height="40" Margin="0,0,10,0" ToolTip="Gỡ bỏ toàn bộ cấu hình DNS và DoH, đưa mạng về lại chế độ Auto mặc định"/>
            <Button x:Name="btnTestSteam" Content="Kiểm tra Kết nối Steam" Click="BtnTestSteam_Click" Grid.Column="1" Background="#2E7D32" BorderBrush="#2E7D32" Foreground="White" Height="40"/>
        </Grid>

        <!-- Log Terminal (Đã cố định Height để không bao giờ bị đè) -->
        <GroupBox Grid.Row="4" Header="Console Logs">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Height="150">
                <TextBlock x:Name="txtLog" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="5"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>